+jboolean
+Java_org_videolan_libvlc_MediaPlayer_nativeSupportsCastSubtitles(JNIEnv *env, jclass clazz)
+{
+    (void)env;
+    (void)clazz;
+    return true;
+}
+
+jboolean
+Java_org_videolan_libvlc_MediaPlayer_nativeSetCastSubtitle(JNIEnv *env, jobject thiz,
+                                                        jbyteArray webvtt)
+{
+    vlcjni_object *object = VLCJniObject_getInstance(env, thiz);
+    if (!object) return false;
+    if (!webvtt)
+        return libvlc_media_player_set_cast_subtitle(object->u.p_mp, NULL) == 0;
+    jsize size = (*env)->GetArrayLength(env, webvtt);
+    if (size > 4 * 1024 * 1024) return false;
+    char *text = malloc((size_t)size + 1);
+    if (!text) return false;
+    (*env)->GetByteArrayRegion(env, webvtt, 0, size, (jbyte *)text);
+    if ((*env)->ExceptionCheck(env) || memchr(text, '\0', size))
+    {
+        free(text);
+        return false;
+    }
+    text[size] = '\0';
+    int result = libvlc_media_player_set_cast_subtitle(object->u.p_mp, text);
+    free(text);
+    return result == 0;
+}

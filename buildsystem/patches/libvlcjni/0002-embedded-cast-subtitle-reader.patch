+struct cast_cancel
+{
+    JNIEnv *env;
+    jobject thread;
+    jmethodID interrupted;
+};
+
+static int cast_interrupted(void *opaque)
+{
+    struct cast_cancel *cancel = opaque;
+    return (*cancel->env)->ExceptionCheck(cancel->env) ||
+        (*cancel->env)->CallBooleanMethod(cancel->env, cancel->thread, cancel->interrupted);
+}
+
+jbyteArray
+Java_org_videolan_libvlc_Media_nativeReadCastSubtitles(JNIEnv *env, jobject thiz, jint index)
+{
+    vlcjni_object *object = VLCJniObject_getInstance(env, thiz);
+    if (!object || index < -1) return NULL;
+    jclass thread_class = (*env)->FindClass(env, "java/lang/Thread");
+    if (!thread_class) return NULL;
+    jmethodID current = (*env)->GetStaticMethodID(env, thread_class, "currentThread", "()Ljava/lang/Thread;");
+    jmethodID interrupted = (*env)->GetMethodID(env, thread_class, "isInterrupted", "()Z");
+    if (!current || !interrupted) { (*env)->DeleteLocalRef(env, thread_class); return NULL; }
+    jobject thread = (*env)->CallStaticObjectMethod(env, thread_class, current);
+    (*env)->DeleteLocalRef(env, thread_class);
+    if (!thread) return NULL;
+    struct cast_cancel cancel = {env, thread, interrupted};
+    char *text = libvlc_media_read_cast_subtitles(object->u.p_m, index, cast_interrupted, &cancel);
+    (*env)->DeleteLocalRef(env, thread);
+    jbyteArray result = NULL;
+    if (text && !(*env)->ExceptionCheck(env))
+    {
+        size_t length = strlen(text);
+        if (length <= 4 * 1024 * 1024)
+        {
+            result = (*env)->NewByteArray(env, length);
+            if (result) (*env)->SetByteArrayRegion(env, result, 0, length, (const jbyte *)text);
+        }
+    }
+    libvlc_free(text);
+    return result;
+}

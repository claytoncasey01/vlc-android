+int libvlc_media_player_set_cast_subtitle(libvlc_media_player_t *mp,
+                                         const char *webvtt)
+{
+    if (webvtt == NULL) webvtt = "";
+    if (strlen(webvtt) > 4 * 1024 * 1024
+     || (*webvtt && strncmp(webvtt, "WEBVTT\n\n", 8)))
+    {
+        libvlc_printerr("Invalid cast subtitle document");
+        return -1;
+    }
+    lock_input(mp);
+    input_thread_t *input = mp->input.p_thread;
+    if (input && mp->input.p_renderer && !var_GetBool(input, "can-seek"))
+    {
+        unlock_input(mp);
+        libvlc_printerr("Changing cast subtitles requires a seekable media");
+        return -1;
+    }
+    char *previous = var_GetString(mp, "cast-subtitle-webvtt");
+    const bool changed = previous == NULL || strcmp(previous, webvtt) != 0;
+    free(previous);
+    int result = changed ? var_SetString(mp, "cast-subtitle-webvtt", webvtt) : VLC_SUCCESS;
+    if (result == VLC_SUCCESS && changed && input && mp->input.p_renderer)
+    {
+        /* Cast cannot add a new side-loaded track through EDIT_TRACKS_INFO.
+         * Restart at the current media time so LOAD includes a fresh track URL.
+         * The normal demux/sout flush also resets the subtitle time origin. */
+        vlc_tick_t time = var_GetInteger(input, "time");
+        result = var_SetInteger(input, "time", time);
+    }
+    unlock_input(mp);
+    return result == VLC_SUCCESS ? 0 : -1;
+}

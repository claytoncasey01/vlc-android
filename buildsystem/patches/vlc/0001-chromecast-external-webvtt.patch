+/* Copyright (C) 2026 VLC authors and VideoLAN. GPL version 2 or later. */
+#undef NDEBUG
+#include "chromecast_subtitles.hpp"
+#include <cassert>
+#include <iostream>
+using namespace cast_subtitles;
+int main() {
+ const std::string document = "WEBVTT\n\n00:00:01.000 --> 00:00:03.000 align:start\n你好 👋\nSecond line\n\n00:00:05.000 --> 00:00:07.250\nLater\n\n";
+ assert(rebase(document,0)==document);
+ assert(rebase(document,2000)=="WEBVTT\n\n00:00:00.000 --> 00:00:01.000 align:start\n你好 👋\nSecond line\n\n00:00:03.000 --> 00:00:05.250\nLater\n\n");
+ assert(rebase(document,3000)=="WEBVTT\n\n00:00:02.000 --> 00:00:04.250\nLater\n\n");
+ assert(rebase(document,8000)=="WEBVTT\n\n");
+ for (const std::string value : {"00:60:00.000","00:00:60.000","00:01.000","999999999999999999999:00:00.000","00:00:00,000"}) {
+  bool failed=false;try{timestamp(value);}catch(const std::invalid_argument&){failed=true;}assert(failed);
+ }
+ assert(timestamp("25:00:01.250")==90001250);
+ assert(timestamp(90001250)=="25:00:01.250");
+ std::cout << track("http://192.0.2.1:8010/session/subtitles-1.vtt") << std::endl;
+ std::cout << "Native WebVTT conversion checks passed\n";
+}

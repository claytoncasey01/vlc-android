+struct intf_sys_t::subtitle_resource
+{
+    const std::string path;
+    const std::string document;
+    httpd_url_t *url;
+
+    subtitle_resource(httpd_host_t *host, std::string resource_path, std::string text)
+        : path(std::move(resource_path)), document(std::move(text)),
+          url(httpd_UrlNew(host, path.c_str(), NULL, NULL))
+    {
+        if (!url) throw std::runtime_error("Cannot create cast subtitle URL");
+        httpd_UrlCatch(url, HTTPD_MSG_GET, serve, reinterpret_cast<httpd_callback_sys_t *>(this));
+        httpd_UrlCatch(url, HTTPD_MSG_HEAD, serve, reinterpret_cast<httpd_callback_sys_t *>(this));
+        httpd_UrlCatch(url, HTTPD_MSG_OPTIONS, serve, reinterpret_cast<httpd_callback_sys_t *>(this));
+    }
+
+    ~subtitle_resource() { httpd_UrlDelete(url); }
+
+    static int serve(httpd_callback_sys_t *opaque, httpd_client_t *,
+                     httpd_message_t *answer, const httpd_message_t *query)
+    {
+        const subtitle_resource &resource = *reinterpret_cast<subtitle_resource *>(opaque);
+        answer->i_proto = HTTPD_PROTO_HTTP;
+        answer->i_version = 1;
+        answer->i_type = HTTPD_MSG_ANSWER;
+        answer->i_status = query->i_type == HTTPD_MSG_OPTIONS ? 204 : 200;
+        httpd_MsgAdd(answer, "Content-Type", "text/vtt; charset=utf-8");
+        httpd_MsgAdd(answer, "Access-Control-Allow-Origin", "*");
+        httpd_MsgAdd(answer, "Access-Control-Allow-Methods", "GET, HEAD, OPTIONS");
+        httpd_MsgAdd(answer, "Access-Control-Allow-Headers", "Range");
+        httpd_MsgAdd(answer, "Cache-Control", "no-store");
+        httpd_MsgAdd(answer, "Connection", "close");
+        const size_t length = query->i_type == HTTPD_MSG_OPTIONS ? 0 : resource.document.size();
+        if (query->i_type == HTTPD_MSG_GET && length != 0)
+        {
+            answer->p_body = static_cast<uint8_t *>(malloc(length));
+            if (!answer->p_body)
+            {
+                answer->i_status = 500;
+                httpd_MsgAdd(answer, "Content-Length", "0");
+                return VLC_SUCCESS;
+            }
+            memcpy(answer->p_body, resource.document.data(), length);
+            answer->i_body = length;
+        }
+        httpd_MsgAdd(answer, "Content-Length", "%zu", length);
+        return VLC_SUCCESS;
+    }
+};
 

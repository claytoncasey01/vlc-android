+#ifndef VLC_CHROMECAST_SUBTITLES_HPP
+#define VLC_CHROMECAST_SUBTITLES_HPP
+
+#include <algorithm>
+#include <cstdint>
+#include <iomanip>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace cast_subtitles
+{
+static constexpr size_t max_document_size = 4 * 1024 * 1024;
+
+inline int64_t timestamp(const std::string &text)
+{
+    std::vector<int64_t> parts;
+    int64_t value = 0;
+    unsigned digits = 0;
+    for (char c : text)
+    {
+        if (c >= '0' && c <= '9')
+        {
+            if (value > (std::numeric_limits<int64_t>::max() - (c - '0')) / 10)
+                throw std::invalid_argument("WebVTT timestamp overflow");
+            value = value * 10 + c - '0';
+            ++digits;
+        }
+        else if ((c == ':' && parts.size() < 2 && digits >= 2)
+              || (c == '.' && parts.size() == 2 && digits == 2))
+        {
+            parts.push_back(value);
+            value = 0;
+            digits = 0;
+        }
+        else
+            throw std::invalid_argument("Invalid WebVTT timestamp");
+    }
+    if (parts.size() != 3 || digits != 3 || parts[1] >= 60 || parts[2] >= 60)
+        throw std::invalid_argument("Invalid WebVTT timestamp");
+    int64_t remainder = parts[1] * 60000 + parts[2] * 1000 + value;
+    if (parts[0] > (std::numeric_limits<int64_t>::max() - remainder) / 3600000)
+        throw std::invalid_argument("WebVTT timestamp overflow");
+    return parts[0] * 3600000 + remainder;
+}
+
+inline std::string timestamp(int64_t ms)
+{
+    std::ostringstream out;
+    out << std::setfill('0') << std::setw(2) << ms / 3600000 << ':'
+        << std::setw(2) << ms / 60000 % 60 << ':'
+        << std::setw(2) << ms / 1000 % 60 << '.' << std::setw(3) << ms % 1000;
+    return out.str();
+}
+
+/* The Android bridge supplies canonical WebVTT, already decoded to UTF-8 and
+ * with any user subtitle delay applied. Never offset the stored source in place:
+ * every cast reload/seek gets a new export on the receiver's zero-based clock. */
+inline std::string rebase(const std::string &document, int64_t origin_ms)
+{
+    if (document.size() > max_document_size || document.compare(0, 8, "WEBVTT\n\n") != 0
+     || document.find('\0') != std::string::npos || origin_ms < 0)
+        throw std::invalid_argument("Invalid cast subtitle document");
+    std::istringstream in(document.substr(8));
+    std::ostringstream out;
+    out << "WEBVTT\n\n";
+    std::string line;
+    while (std::getline(in, line))
+    {
+        if (line.empty()) continue;
+        std::istringstream timing(line);
+        std::string start_text, arrow, end_text, settings;
+        if (!(timing >> start_text >> arrow >> end_text) || arrow != "-->")
+            throw std::invalid_argument("Invalid WebVTT cue timing");
+        std::getline(timing, settings);
+        int64_t start = timestamp(start_text), end = timestamp(end_text);
+        if (end <= start) throw std::invalid_argument("Invalid WebVTT cue duration");
+        std::string payload, text;
+        while (std::getline(in, text) && !text.empty())
+        {
+            if (text.find("-->") != std::string::npos)
+                throw std::invalid_argument("Invalid WebVTT cue text");
+            payload += text + '\n';
+        }
+        if (payload.empty()) throw std::invalid_argument("Empty WebVTT cue");
+        if (end <= origin_ms) continue;
+        out << timestamp(std::max<int64_t>(start - origin_ms, 0)) << " --> "
+            << timestamp(end - origin_ms) << settings << '\n' << payload << '\n';
+    }
+    return out.str();
+}
+
+inline std::string track(const std::string &url)
+{
+    // URLs are generated by VLC's HTTP server, never supplied by the caller.
+    if (url.find_first_of("\"\\\r\n") != std::string::npos)
+        throw std::invalid_argument("Invalid subtitle URL");
+    return "\"tracks\":[{\"trackId\":1,\"type\":\"TEXT\",\"subtype\":\"SUBTITLES\","
+           "\"trackContentId\":\"" + url + "\",\"trackContentType\":\"text/vtt\","
+           "\"language\":\"und\",\"name\":\"External subtitles\"}]";
+}
+}

+
+void intf_sys_t::prepareHttpSubtitles()
+{
+    // Resources are immutable. HTTP callbacks never acquire m_lock, so replacing
+    // an endpoint while holding it cannot deadlock with an in-flight request.
+    m_subtitle_resource.reset();
+    vlc_object_t *owner = m_module->obj.parent->obj.parent;
+    if (!var_Type(owner, CC_SUBTITLE_VAR_NAME)) return;
+    std::unique_ptr<char, decltype(&free)> source(var_GetString(owner, CC_SUBTITLE_VAR_NAME), &free);
+    if (!source || !*source) return;
+    try {
+        std::string document = cast_subtitles::rebase(source.get(),
+                                                     m_stream_origin / 1000);
+        const std::string path = getHttpArtRoot() + "/subtitles-" +
+                                 std::to_string(++m_subtitle_revision) + ".vtt";
+        m_subtitle_resource.reset(new subtitle_resource(m_httpd.m_host, path,
+                                                        std::move(document)));
+    } catch (const std::exception &error) {
+        msg_Err(m_module, "Cannot serve cast subtitles: %s", error.what());
+    }
+}

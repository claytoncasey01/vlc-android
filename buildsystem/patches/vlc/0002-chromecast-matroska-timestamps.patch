diff --git a/modules/demux/avformat/matroska_dts.h b/modules/demux/avformat/matroska_dts.h
new file mode 100644
index 00000000..7c2c8849
--- /dev/null
+++ b/modules/demux/avformat/matroska_dts.h
@@ -0,0 +1,31 @@
+/*****************************************************************************
+ * matroska_dts.h: initial decode timestamps for reordered Matroska video
+ *****************************************************************************
+ * Copyright (C) 2026 VLC authors and VideoLAN
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1, or any later version.
+ *****************************************************************************/
+
+#ifndef VLC_AVFORMAT_MATROSKA_DTS_H
+#define VLC_AVFORMAT_MATROSKA_DTS_H
+#include <stdint.h>
+
+/* libavformat can leave the first reordered packets without a DTS. Seed those
+ * from the codec's parsed reorder delay, then use the previous decode time.
+ * Never replace decode timestamps that the demuxer has already supplied. */
+static inline int64_t vlc_matroska_initial_dts(int64_t pts, int64_t dts,
+                                              int64_t previous, int64_t duration,
+                                              int reorder)
+{
+    if (dts != INT64_MIN || pts == INT64_MIN || duration <= 0
+     || reorder <= 0 || reorder > 16)
+        return dts;
+    if (previous != INT64_MIN)
+        return previous <= INT64_MAX - duration ? previous + duration : dts;
+    if (duration > INT64_MAX / reorder)
+        return dts;
+    const int64_t offset = duration * reorder;
+    return pts > INT64_MIN + offset ? pts - offset : dts;
+}
+#endif

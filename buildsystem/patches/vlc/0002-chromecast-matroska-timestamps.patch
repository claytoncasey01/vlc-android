+    /* Matroska stores presentation times, not decode times. The native MKV
+     * demuxer's estimates can go backwards for reordered HEVC frames. Modern
+     * libavformat rejects those packets when Chromecast remuxes them. Use its
+     * demuxer as well, so codec parsing supplies the decode timestamps. Keep
+     * explicit demux choices, preparsing, and local playback unchanged. */
+    if( !priv->b_preparsing && priv->p_renderer

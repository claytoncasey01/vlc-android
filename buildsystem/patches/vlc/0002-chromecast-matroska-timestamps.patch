+     && (!psz_demux[0] || !strcmp( psz_demux, "any" ))
+     && module_exists( "avformat" ) )
+    {
+        const uint8_t *header;
+        if( vlc_stream_Peek( p_stream, &header, 4 ) == 4
+         && !memcmp( header, "\x1a\x45\xdf\xa3", 4 ) )
+        {
+            msg_Dbg( p_input, "Using avformat for Chromecast Matroska decode timestamps" );
+            psz_demux = "avformat";

+char *libvlc_media_read_cast_subtitles(libvlc_media_t *media, int stream_index,
+                                      int (*cancel)(void *), void *opaque)
+{
+    char *url = libvlc_media_get_mrl(media);
+    if (!url) return NULL;
+    cast_subtitle_request_t *request = vlc_object_create(media->p_libvlc_instance->p_libvlc_int, sizeof(*request));
+    if (!request) { free(url); return NULL; }
+    request->url = url;
+    request->stream_index = stream_index;
+    request->cancel = cancel;
+    request->opaque = opaque;
+    request->result = NULL;
+    module_t *module = module_need(request, "cast subtitle extractor", "cast_subtitle", true);
+    char *result = request->result;
+    if (module) module_unneed(request, module);
+    vlc_object_release(request);
+    free(url);
+    return result;
+}

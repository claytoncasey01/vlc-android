diff --git a/modules/misc/cast_subtitle.cpp b/modules/misc/cast_subtitle.cpp
new file mode 100644
index 00000000..3c674ac3
--- /dev/null
+++ b/modules/misc/cast_subtitle.cpp
@@ -0,0 +1,88 @@
+/* Copyright (C) 2026 VLC authors and VideoLAN. LGPL version 2.1 or later. */
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+#include <vlc_common.h>
+#include <vlc_plugin.h>
+#include <vlc_stream.h>
+#include <vlc_cast_subtitle.h>
+#include "cast_subtitle_extractor.hpp"
+
+static int Extract(vlc_object_t *);
+vlc_module_begin()
+    set_description("Embedded Chromecast text subtitle extractor")
+    set_capability("cast subtitle extractor", 0)
+    add_shortcut("cast_subtitle")
+    set_callbacks(Extract, NULL)
+vlc_module_end()
+
+struct reader
+{
+    cast_subtitle_request_t *request;
+    stream_t *stream;
+    vlc_tick_t deadline;
+};
+static int Cancel(void *opaque)
+{
+    reader *input = static_cast<reader *>(opaque);
+    return mdate() >= input->deadline ||
+        (input->request->cancel && input->request->cancel(input->request->opaque));
+}
+static int Read(void *opaque, uint8_t *data, int size)
+{
+    reader *input = static_cast<reader *>(opaque);
+    if (Cancel(input)) return AVERROR_EXIT;
+    ssize_t count = vlc_stream_Read(input->stream, data, size);
+    return count > 0 ? int(count) : count == 0 ? AVERROR_EOF : AVERROR(EIO);
+}
+static int64_t Seek(void *opaque, int64_t offset, int whence)
+{
+    reader *input = static_cast<reader *>(opaque);
+    if (Cancel(input)) return AVERROR_EXIT;
+    whence &= ~AVSEEK_FORCE;
+    if (whence == AVSEEK_SIZE) return stream_Size(input->stream);
+    int64_t origin = whence == SEEK_SET ? 0 : whence == SEEK_CUR ? int64_t(vlc_stream_Tell(input->stream))
+                   : whence == SEEK_END ? stream_Size(input->stream) : -1;
+    if (origin < 0 || (offset > 0 && origin > INT64_MAX - offset) || offset < -origin) return AVERROR(EINVAL);
+    int64_t position = origin + offset;
+    return vlc_stream_Seek(input->stream, position) == VLC_SUCCESS ? position : AVERROR(EIO);
+}
+static int Extract(vlc_object_t *object)
+{
+    cast_subtitle_request_t *request = reinterpret_cast<cast_subtitle_request_t *>(object);
+    /* Local seekable media only. Network extraction would scan an entire remote movie. */
+    if (strncmp(request->url, "file://", 7) && strncmp(request->url, "fd://", 5)) return VLC_EGENERIC;
+    stream_t *stream = vlc_stream_NewURL(object, request->url);
+    if (!stream) return VLC_EGENERIC;
+    bool seekable = false;
+    vlc_stream_Control(stream, STREAM_CAN_SEEK, &seekable);
+    if (!seekable) { vlc_stream_Delete(stream); return VLC_EGENERIC; }
+    reader input{request, stream, mdate() + VLC_TICK_FROM_SEC(request->stream_index < 0 ? 10 : 120)};
+    unsigned char *buffer = static_cast<unsigned char *>(av_malloc(32768));
+    AVIOContext *io = buffer ? avio_alloc_context(buffer, 32768, 0, &input, Read, NULL, Seek) : NULL;
+    if (!io) { av_free(buffer); vlc_stream_Delete(stream); return VLC_ENOMEM; }
+    AVFormatContext *format = avformat_alloc_context();
+    int status = VLC_EGENERIC;
+    if (format)
+    {
+        format->pb = io;
+        format->flags |= AVFMT_FLAG_CUSTOM_IO;
+        format->interrupt_callback = AVIOInterruptCB{Cancel, &input};
+        if (avformat_open_input(&format, NULL, NULL, NULL) >= 0)
+        {
+            try
+            {
+                std::string result = request->stream_index < 0 ? embedded_cast::tracks(format)
+                                                             : embedded_cast::extract(format, request->stream_index);
+                request->result = strdup(result.c_str());
+                status = request->result ? VLC_SUCCESS : VLC_ENOMEM;
+            }
+            catch (const std::exception &error) { msg_Warn(object, "Embedded cast subtitles: %s", error.what()); }
+        }
+        avformat_close_input(&format);
+    }
+    av_freep(&io->buffer);
+    avio_context_free(&io);
+    vlc_stream_Delete(stream);
+    return status;
+}
diff --git a/modules/misc/cast_subtitle_extractor.hpp b/modules/misc/cast_subtitle_extractor.hpp
new file mode 100644
index 00000000..1fb72e5b
--- /dev/null
+++ b/modules/misc/cast_subtitle_extractor.hpp
@@ -0,0 +1,241 @@
+/* Copyright (C) 2026 VLC authors and VideoLAN. LGPL version 2.1 or later. */
+#ifndef VLC_CAST_SUBTITLE_EXTRACTOR_HPP
+#define VLC_CAST_SUBTITLE_EXTRACTOR_HPP
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+extern "C" {
+#include <libavformat/avformat.h>
+}
+#include "../stream_out/chromecast/chromecast_subtitles.hpp"
+
+namespace embedded_cast
+{
+inline bool supported(AVCodecID codec)
+{
+    return codec == AV_CODEC_ID_SUBRIP || codec == AV_CODEC_ID_TEXT
+        || codec == AV_CODEC_ID_ASS || codec == AV_CODEC_ID_SSA
+        || codec == AV_CODEC_ID_MOV_TEXT || codec == AV_CODEC_ID_WEBVTT;
+}
+
+inline std::string quote(const std::string &text)
+{
+    std::string result = "\"";
+    for (unsigned char c : text)
+    {
+        if (c == '"' || c == '\\') result += '\\';
+        if (c < 32) { char escape[7]; std::snprintf(escape, sizeof(escape), "\\u%04x", c); result += escape; }
+        else result += c;
+    }
+    return result + '"';
+}
+
+inline std::string tracks(AVFormatContext *format)
+{
+    std::string json = "[";
+    unsigned count = 0;
+    for (unsigned i = 0; i < format->nb_streams; ++i)
+    {
+        AVStream *stream = format->streams[i];
+        if (stream->codecpar->codec_type != AVMEDIA_TYPE_SUBTITLE || !supported(stream->codecpar->codec_id)) continue;
+        if (count++) json += ',';
+        AVDictionaryEntry *title = av_dict_get(stream->metadata, "title", NULL, 0);
+        AVDictionaryEntry *language = av_dict_get(stream->metadata, "language", NULL, 0);
+        json += "{\"index\":" + std::to_string(i) + ",\"title\":" + quote(title ? title->value : "")
+              + ",\"language\":" + quote(language ? language->value : "") + "}";
+    }
+    return json + ']';
+}
+
+inline void utf8(std::string &out, uint32_t point)
+{
+    if (point < 0x80) out += static_cast<char>(point);
+    else if (point < 0x800) { out += char(0xc0 | (point >> 6)); out += char(0x80 | (point & 63)); }
+    else if (point < 0x10000) { out += char(0xe0 | (point >> 12)); out += char(0x80 | ((point >> 6) & 63)); out += char(0x80 | (point & 63)); }
+    else { out += char(0xf0 | (point >> 18)); out += char(0x80 | ((point >> 12) & 63)); out += char(0x80 | ((point >> 6) & 63)); out += char(0x80 | (point & 63)); }
+}
+
+inline std::string mov_text(const uint8_t *data, size_t size)
+{
+    if (size < 2) throw std::invalid_argument("Truncated MP4 subtitle");
+    size_t length = (size_t(data[0]) << 8) | data[1];
+    if (length > size - 2) throw std::invalid_argument("Truncated MP4 subtitle text");
+    data += 2;
+    if (length < 2 || !((data[0] == 0xfe && data[1] == 0xff) || (data[0] == 0xff && data[1] == 0xfe)))
+        return std::string(reinterpret_cast<const char *>(data), length);
+    if (length % 2) throw std::invalid_argument("Truncated UTF-16 subtitle");
+    bool little = data[0] == 0xff;
+    auto unit = [data, little](size_t i) { return little ? uint32_t(data[i]) | (uint32_t(data[i+1]) << 8) : (uint32_t(data[i]) << 8) | data[i+1]; };
+    std::string out;
+    for (size_t i = 2; i < length; i += 2)
+    {
+        uint32_t point = unit(i);
+        if (point >= 0xd800 && point <= 0xdbff)
+        {
+            if (i + 3 >= length) throw std::invalid_argument("Truncated UTF-16 surrogate");
+            uint32_t low = unit(i += 2);
+            if (low < 0xdc00 || low > 0xdfff) throw std::invalid_argument("Invalid UTF-16 surrogate");
+            point = 0x10000 + ((point - 0xd800) << 10) + low - 0xdc00;
+        }
+        else if (point >= 0xdc00 && point <= 0xdfff) throw std::invalid_argument("Invalid UTF-16 surrogate");
+        utf8(out, point);
+    }
+    return out;
+}
+
+/* Strip ASS positioning/styles and vector drawings, retaining readable dialogue. */
+inline std::string ass_text(const std::string &packet)
+{
+    size_t start = 0;
+    unsigned fields = packet.compare(0, 9, "Dialogue:") == 0 ? 9 : 8;
+    for (unsigned i = 0; i < fields; ++i)
+    {
+        size_t comma = packet.find(',', start);
+        if (comma == std::string::npos) throw std::invalid_argument("Malformed ASS dialogue");
+        start = comma + 1;
+    }
+    std::string out;
+    bool drawing = false;
+    for (size_t i = start; i < packet.size(); ++i)
+    {
+        if (packet[i] == '{')
+        {
+            size_t end = packet.find('}', i + 1);
+            if (end == std::string::npos) throw std::invalid_argument("Unclosed ASS override");
+            for (size_t p = i + 1; p + 2 < end; ++p)
+            {
+                if (packet[p] != '\\' || packet[p+1] != 'p') continue;
+                size_t n = p + 2;
+                while (n < end && packet[n] == ' ') ++n;
+                if (n < end && packet[n] >= '0' && packet[n] <= '9') drawing = packet[n] != '0';
+            }
+            i = end;
+        }
+        else if (packet[i] == '\\' && i + 1 < packet.size() &&
+                 (packet[i+1] == 'N' || packet[i+1] == 'n' || packet[i+1] == 'h'))
+        {
+            if (!drawing) out += packet[i+1] == 'h' ? ' ' : '\n';
+            ++i;
+        }
+        else if (!drawing) out += packet[i];
+    }
+    return out;
+}
+
+inline std::string canonical_text(std::string text, bool ass)
+{
+    /* Preserve simple subtitle emphasis only. Escape arbitrary markup/entities. */
+    std::string out;
+    for (size_t i = 0; i < text.size(); ++i)
+    {
+        unsigned char c = text[i];
+        if (c == 0) throw std::invalid_argument("NUL in subtitle text");
+        if (c == '\r') { if (i + 1 < text.size() && text[i+1] == '\n') ++i; out += '\n'; }
+        else if (c == '<' && !ass)
+        {
+            size_t end = text.find('>', i);
+            std::string tag = end == std::string::npos ? "" : text.substr(i, end - i + 1);
+            if (tag == "<b>" || tag == "</b>" || tag == "<i>" || tag == "</i>" || tag == "<u>" || tag == "</u>") { out += tag; i = end; }
+            else if (tag == "<br>" || tag == "<br/>") { out += '\n'; i = end; }
+            else out += "&lt;";
+        }
+        else if (c == '<') out += "&lt;";
+        else if (c == '>') out += "&gt;";
+        else if (c == '&')
+        {
+            size_t end = text.find(';', i);
+            std::string entity = end == std::string::npos ? "" : text.substr(i, end - i + 1);
+            if (!ass && (entity == "&amp;" || entity == "&lt;" || entity == "&gt;" || entity == "&nbsp;")) { out += entity; i = end; }
+            else out += "&amp;";
+        }
+        else if (c >= 32 || c == '\n' || c == '\t') out += c;
+    }
+    /* Blank payload lines terminate WebVTT cues; collapse them inside dialogue. */
+    std::string clean;
+    size_t pos = 0;
+    while (pos < out.size())
+    {
+        size_t end = out.find('\n', pos);
+        if (end == std::string::npos) end = out.size();
+        std::string line = out.substr(pos, end - pos);
+        if (line.find_first_not_of(" \t") != std::string::npos)
+        {
+            if (!clean.empty()) clean += '\n';
+            clean += line;
+        }
+        pos = end + 1;
+    }
+    return clean;
+}
+
+struct cue { int64_t start, end; std::string text; };
+
+inline std::string extract(AVFormatContext *format, int index)
+{
+    if (index < 0 || unsigned(index) >= format->nb_streams ||
+        format->streams[index]->codecpar->codec_type != AVMEDIA_TYPE_SUBTITLE ||
+        !supported(format->streams[index]->codecpar->codec_id))
+        throw std::invalid_argument("Unsupported embedded subtitle track");
+    AVStream *stream = format->streams[index];
+    AVCodecID codec = stream->codecpar->codec_id;
+    /* Discard unwanted streams. Never decode A/V. Matroska may still scan their payloads. */
+    for (unsigned i = 0; i < format->nb_streams; ++i)
+        format->streams[i]->discard = int(i) == index ? AVDISCARD_DEFAULT : AVDISCARD_ALL;
+    std::vector<cue> cues;
+    size_t bytes = 0;
+    AVPacket *packet = av_packet_alloc();
+    if (!packet) throw std::bad_alloc();
+    try
+    {
+        int result;
+        while ((result = av_read_frame(format, packet)) >= 0)
+        {
+            if (format->interrupt_callback.callback && format->interrupt_callback.callback(format->interrupt_callback.opaque))
+                throw std::runtime_error("Subtitle extraction cancelled");
+            if (packet->stream_index == index && packet->pts != AV_NOPTS_VALUE)
+            {
+                int64_t start = av_rescale_q(packet->pts, stream->time_base, AVRational{1, 1000});
+                int64_t duration = packet->duration > 0 ? av_rescale_q(packet->duration, stream->time_base, AVRational{1, 1000}) : 0;
+                if (duration > 0 && start > std::numeric_limits<int64_t>::max() - duration)
+                    throw std::invalid_argument("Subtitle timestamp overflow");
+                std::string raw = codec == AV_CODEC_ID_MOV_TEXT ? mov_text(packet->data, packet->size)
+                    : packet->size > 0 ? std::string(reinterpret_cast<const char *>(packet->data), packet->size) : "";
+                bool ass = codec == AV_CODEC_ID_ASS || codec == AV_CODEC_ID_SSA;
+                std::string text = canonical_text(ass && !raw.empty() ? ass_text(raw) : raw, ass);
+                if (!cues.empty() && cues.back().end <= cues.back().start && start > cues.back().start)
+                    cues.back().end = start;
+                if (!text.empty())
+                {
+                    bytes += text.size() + 80;
+                    if (bytes > cast_subtitles::max_document_size || cues.size() >= 100000)
+                        throw std::invalid_argument("Embedded subtitle document is too large");
+                    cues.push_back(cue{start, start + duration, std::move(text)});
+                }
+            }
+            av_packet_unref(packet);
+        }
+        if (result != AVERROR_EOF) throw std::runtime_error("Could not finish reading embedded subtitles");
+        if (cues.empty()) throw std::invalid_argument("Embedded subtitle track contains no text");
+        if (cues.back().end <= cues.back().start && format->duration != AV_NOPTS_VALUE)
+            cues.back().end = format->duration / 1000;
+        std::stable_sort(cues.begin(), cues.end(), [](const cue &a, const cue &b) { return a.start < b.start; });
+        std::string document = "WEBVTT\n\n";
+        for (const cue &item : cues)
+        {
+            if (item.end <= 0) continue;
+            if (item.end <= item.start) throw std::invalid_argument("Missing embedded subtitle duration");
+            document += cast_subtitles::timestamp(std::max<int64_t>(item.start, 0)) + " --> "
+                      + cast_subtitles::timestamp(item.end) + '\n' + item.text + "\n\n";
+        }
+        if (document.size() > cast_subtitles::max_document_size) throw std::invalid_argument("Embedded subtitle document is too large");
+        av_packet_free(&packet);
+        return document;
+    }
+    catch (...) { av_packet_free(&packet); throw; }
+}
+}
+#endif

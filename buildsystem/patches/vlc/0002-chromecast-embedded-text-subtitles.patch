diff --git a/test/modules/stream_out/embedded_cast_subtitles.cpp b/test/modules/stream_out/embedded_cast_subtitles.cpp
new file mode 100644
index 00000000..b4a67a12
--- /dev/null
+++ b/test/modules/stream_out/embedded_cast_subtitles.cpp
@@ -0,0 +1,67 @@
+/* Copyright (C) 2026 VLC authors and VideoLAN. GPL version 2 or later. */
+#undef NDEBUG
+#include "cast_subtitle_extractor.hpp"
+#include <cassert>
+#include <iostream>
+
+static AVFormatContext *open(const char *path)
+{
+    AVFormatContext *format = NULL;
+    assert(avformat_open_input(&format, path, NULL, NULL) == 0);
+    return format;
+}
+
+static std::string read(const char *path, int index)
+{
+    AVFormatContext *format = open(path);
+    std::string result = embedded_cast::extract(format, index);
+    for (unsigned i = 0; i < format->nb_streams; ++i)
+        assert(format->streams[i]->discard == (int(i) == index ? AVDISCARD_DEFAULT : AVDISCARD_ALL));
+    avformat_close_input(&format);
+    return result;
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 3);
+    using namespace embedded_cast;
+    assert(ass_text("0,0,Default,,0,0,0,,{\\i1}Hello, world!{\\i0}\\N你好 👋") == "Hello, world!\n你好 👋");
+    assert(ass_text("Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,Hello") == "Hello");
+    assert(ass_text("0,0,Default,,0,0,0,,{\\p1}m 0 0 l 2 2{\\p0}Text") == "Text");
+    assert(canonical_text("A\n\n  \nB & <x> -->", true) == "A\nB &amp; &lt;x&gt; --&gt;");
+    const uint8_t utf16[] = {0, 6, 0xfe, 0xff, 0xd8, 0x3d, 0xdc, 0x4b};
+    assert(mov_text(utf16, sizeof(utf16)) == "👋");
+    bool failed = false;
+    try { mov_text(utf16, 4); } catch (const std::invalid_argument &) { failed = true; }
+    assert(failed);
+    assert(!supported(AV_CODEC_ID_HDMV_PGS_SUBTITLE));
+    AVFormatContext *format = open(argv[1]);
+    std::string metadata = tracks(format);
+    assert(metadata.find("\"index\":1") != std::string::npos);
+    assert(metadata.find("\"index\":2") != std::string::npos);
+    assert(metadata.find("\"title\":\"English ASS\"") != std::string::npos);
+    assert(metadata.find("\"language\":\"eng\"") != std::string::npos);
+    avformat_close_input(&format);
+    const std::string ass = read(argv[1], 1);
+    assert(ass.find("00:00:01.000 --> 00:00:03.000\nHello, world!\n你好 👋") != std::string::npos);
+    assert(ass.find("00:00:04.000 --> 00:00:05.500\nLater") != std::string::npos);
+    assert(ass.find("{\\") == std::string::npos);
+    const std::string srt = read(argv[1], 2);
+    assert(srt.find("00:00:02.000 --> 00:00:03.500\nOther track") != std::string::npos);
+    assert(srt.find("Hello") == std::string::npos);
+    const std::string mp4 = read(argv[2], 1);
+    assert(mp4.find("00:00:02.000 --> 00:00:03.500\nOther track") != std::string::npos);
+    assert(cast_subtitles::rebase(ass, 2000).find("00:00:00.000 --> 00:00:01.000\nHello") != std::string::npos);
+    format = open(argv[1]);
+    failed = false;
+    try { extract(format, 0); } catch (const std::invalid_argument &) { failed = true; }
+    assert(failed);
+    avformat_close_input(&format);
+    format = open(argv[1]);
+    format->interrupt_callback.callback = [](void *) { return 1; };
+    failed = false;
+    try { extract(format, 1); } catch (const std::runtime_error &) { failed = true; }
+    assert(failed);
+    avformat_close_input(&format);
+    std::cout << "Embedded extraction checks passed (ASS, SRT, MP4 text, Unicode, timing, selection, cancellation)\n";
+}
